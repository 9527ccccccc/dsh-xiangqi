{
  "name": "dsh-xiangqi",
  "version": "0.1.0",
  "description": "中国象棋：棋规引擎 + DSH 插件（右栏棋盘 + 会话可调用的工具）",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "src/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "xiangqi",
    "chinese-chess",
    "chess",
    "象棋"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/9527ccccccc/dsh-xiangqi.git"
  },
  "homepage": "https://github.com/9527ccccccc/dsh-xiangqi#readme",
  "bugs": {
    "url": "https://github.com/9527ccccccc/dsh-xiangqi/issues"
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --import ./test-support/dsh-stub.mjs --test",
    "test:fast": "node --import ./test-support/dsh-stub.mjs --test --test-name-pattern=\"perft 深度 (1|2|3)\""
  }
}
